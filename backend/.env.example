# Copy to .env, then fill in YOUR local PostgreSQL credentials.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
ENABLE_DATABASE=true
DATABASE_URL="postgresql://fulfillment:YOUR_PASSWORD@127.0.0.1:5433/fulfillment"

# Neon runtime: pooled URL with SSL from Neon Connect dialog.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Initialize a NEW empty cloud database from your computer using a direct URL.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Vercel: FRONTEND_ORIGIN=https://YOUR-WEB.vercel.app (no trailing slash)
